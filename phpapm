#!/usr/bin/env python3
"""Read-only PHP APM advisor: appcount, version counts, extension state and commands."""
import argparse
import os
import re
import shutil
import subprocess
import tempfile
from collections import Counter
from pathlib import Path

APPCOUNT_URL = "https://raw.githubusercontent.com/Muihammadusman2478/myvar/refs/heads/main/appcount.sh"
PHP_ROOT = Path('/etc/php')

def command(args, timeout=15):
    try:
        return subprocess.run(args, text=True, capture_output=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None

def show(title):
    print('\n' + '=' * 68 + '\n' + title + '\n' + '=' * 68)

def status(label, value):
    print(f'{label:<25} {value}')

def suggestion(title, text):
    print(f'\n# {title}\n{text}')

def get_os():
    vals = {}
    p = Path('/etc/os-release')
    if p.exists():
        for line in p.read_text(errors='replace').splitlines():
            if '=' in line and not line.startswith('#'):
                k, v = line.split('=', 1)
                vals[k] = v.strip().strip('"')
    return vals

def installed(pkg):
    res = command(['dpkg-query','-W','-f=${Status} ${Version}',pkg])
    if res and res.returncode == 0 and res.stdout.startswith('install ok installed'):
        return res.stdout.strip().split()[-1]
    return None

def appcount():
    """Download, syntax-check, and execute the user's existing appcount script."""
    if not shutil.which('curl'):
        return None, 'curl is missing'
    with tempfile.TemporaryDirectory(prefix='nr-appcount-') as directory:
        dest = str(Path(directory) / 'appcount.sh')
        fetched = command(['curl','-fsSL','--connect-timeout','10','--max-time','60',APPCOUNT_URL,'-o',dest],timeout=70)
        if not fetched or fetched.returncode != 0:
            return None, 'appcount download failed'
        synt = command(['bash','-n',dest])
        if not synt or synt.returncode != 0:
            return None, 'appcount Bash syntax check failed'
        # appcount.sh is expected to define a function named appcount.
        result = command(['bash','-c','source "$1"; if declare -F appcount >/dev/null; then appcount; else exit 45; fi','bash',dest],timeout=75)
        if result and result.returncode == 0:
            return result.stdout, None
        return None, 'appcount execution failed / function not defined'

def parse_apps(output):
    apps = []
    for line in output.splitlines():
        # Typical appcount table: app_name | url | ssh | state | stack | PHP version
        if '|' not in line or line.lstrip().startswith('-') or 'app_name' in line:
            continue
        cols = [x.strip() for x in line.split('|')]
        if len(cols) < 6 or not re.fullmatch(r'[a-z]{8,16}',cols[0]):
            continue
        version = cols[-1]
        if re.fullmatch(r'\d+\.\d+',version):
            apps.append({'id':cols[0], 'url':cols[1], 'state':cols[3], 'stack':cols[4], 'php':version})
    return apps

def license_state(path):
    if not path.is_file():
        return 'FILE MISSING'
    try:
        values = re.findall(r'^\s*newrelic\.license\s*=\s*(.*?)\s*$',path.read_text(errors='replace'),re.M)
        if not values:
            return 'DIRECTIVE MISSING'
        v = values[-1].split(';',1)[0].strip().strip('"\'')
        if not v or v in ('YOUR_LICENSE_KEY','REPLACE_WITH_REAL_KEY'):
            return 'EMPTY / PLACEHOLDER'
        return 'POPULATED (not validated)'
    except OSError:
        return 'UNREADABLE'

parser=argparse.ArgumentParser(description='Read-only PHP APM advisor for Cloudways servers')
parser.add_argument('--skip-appcount',action='store_true',help='Do not execute downloaded appcount function')
args=parser.parse_args()

show('NEW RELIC PHP APM ADVISOR — READ ONLY')
osinfo=get_os()
status('Hostname',os.uname().nodename)
status('Operating system',osinfo.get('PRETTY_NAME','Unknown'))
status('Architecture',os.uname().machine)
status('Runs configuration changes','NO')

show('1. CLOUDWAYS APPLICATIONS / MULTI-PHP')
apps=[]
if not args.skip_appcount:
    print('Source of appcount function:',APPCOUNT_URL)
    print('CAUTION: Running downloaded appcount.sh requires trusting its contents.')
    raw,err=appcount()
    if raw:
        apps=parse_apps(raw)
        for label, pattern in [
            ('Total applications', r'^Total applications:\s*(\d+)'),
            ('Multi-PHP enabled', r'^multi_app_php:\s*(\S+)'),
        ]:
            match=re.search(pattern,raw,re.M|re.I)
            status(label,match.group(1) if match else 'not available')
    else:
        print('Appcount unavailable:',err)
else:
    print('appcount skipped by request')
if apps:
    show('2. APPLICATION COUNTS BY PHP VERSION')
    counts=Counter(a['php'] for a in apps)
    for v in sorted(counts,key=lambda x:tuple(map(int,x.split('.')))):
        print(f'PHP {v}: {counts[v]} application(s)')
else:
    print('WARNING: Could not reliably parse application-to-PHP mapping.')
    print('Confirm target PHP version manually before using any suggested changes.')

show('3. NEW RELIC AGENT PACKAGES')
for pkg in ['newrelic-php5','newrelic-php5-common','newrelic-daemon','newrelic-sysmond']:
    status(pkg,installed(pkg) or 'NOT INSTALLED')

show('4. PHP VERSION-WISE CONFIG AND FPM STATUS')
versions=sorted((p.name for p in PHP_ROOT.glob('*') if p.is_dir() and re.fullmatch(r'\d+\.\d+',p.name)),key=lambda x:tuple(map(int,x.split('.'))))
state={}
for v in versions:
    base=PHP_ROOT/v
    ini=base/'mods-available'/'newrelic.ini'
    conf=base/'fpm'/'conf.d'
    links=sorted(conf.glob('*newrelic*.ini')) if conf.is_dir() else []
    links=[p for p in links if p.exists()]
    query=command(['phpquery','-v',v,'-s','fpm','-m','newrelic'])
    enabled=bool(query and query.returncode == 0)
    svc=command(['systemctl','is-active',f'php{v}-fpm'])
    state[v]={'ini':ini,'enabled':enabled,'links':links,'service':svc.stdout.strip() if svc and svc.stdout.strip() else 'unknown'}
    print(f'\n--- PHP {v} ---')
    status('Applications (appcount)',str(Counter(a['php'] for a in apps).get(v,0)) if apps else 'unknown')
    status('INI path',str(ini))
    status('INI exists',str(ini.is_file()))
    status('License',license_state(ini))
    status('FPM extension','ENABLED' if enabled else 'NOT ENABLED / NOT CONFIRMED')
    for link in links:
        status('FPM config path',str(link))
        status('Symlink target',str(link.resolve()))
    status('FPM service',state[v]['service'])

show('5. DAEMON / LOGS')
proc=command(['pgrep','-af','[/]usr/bin/newrelic-daemon'])
print(proc.stdout.strip() if proc and proc.returncode==0 else 'New Relic PHP daemon not running (may start on PHP activity)')
for name in ['newrelic-daemon.log','php_agent.log']:
    p=Path('/var/log/newrelic')/name
    print(f'\nLog path: {p} | {"FOUND" if p.is_file() else "MISSING"}')
    if p.is_file():
        try:
            lines=p.read_text(errors='replace').splitlines()[-20:]
            # Avoid leaking potential credentials or tokens; still review before sharing.
            for line in lines:
                line=re.sub(r'(?i)(license(?:_key)?\s*[:=]\s*)\S+',r'\1[REDACTED]',line)
                line=re.sub(r'(?i)(run id\s+[\'\"])[^\'\"]+',r'\1[REDACTED]',line)
                print(line)
        except OSError:
            print('Cannot read log')

show('6. RECOMMENDED MANUAL STEPS')
print('The commands below are ADVICE ONLY. Review server scope, permissions and get approval.')
if osinfo.get('ID')!='debian' or osinfo.get('VERSION_ID') not in ('11','12','13'):
    print('Unsupported/unverified Debian release for this advisor. Verify official instructions before installing.')
elif not installed('newrelic-php5'):
    suggestion('Agent package missing — inspect existing APT sources and candidates first',
       "grep -RHn 'newrelic' /etc/apt/sources.list /etc/apt/sources.list.d/ 2>/dev/null\napt-cache policy newrelic-php5\napt-get -s install newrelic-php5")
    suggestion('After checking official New Relic repository and package dependencies',
       'apt-get update\napt-get install newrelic-php5\n# If nonstandard PHP is not configured, review: newrelic-install install')
else:
    print('[OK] PHP agent package already installed; do not reinstall unnecessarily.')

show('7. VERSION-WISE MANUAL SETUP AND POST-CHECKS')
print('No per-application or pool configuration changes are suggested here.')
print('CAUTION: enabling New Relic for a PHP version affects every FPM pool using that version.')
print('Check existing monitoring scope and get approval before any changes.')
for v in versions:
    data=state[v]
    ini=data['ini']
    count=Counter(a['php'] for a in apps).get(v,0) if apps else None
    if count == 0 and apps:
        continue
    print(f'\n--- PHP {v} | applications: {count if count is not None else "unknown"} ---')
    suggestion('Show license path, line number and full value MANUALLY (SECRET: do not share output)',
       f"grep -HnE '^[[:space:]]*newrelic\\.license[[:space:]]*=' {ini}")
    suggestion('Check whether extension is enabled (read-only)',
       f"phpquery -v {v} -s fpm -m newrelic\nls -l /etc/php/{v}/fpm/conf.d/*newrelic* 2>/dev/null")
    if not ini.is_file():
        print('[STOP] New Relic INI missing for this PHP version. Verify package/config setup first.')
        continue
    if license_state(ini) != 'POPULATED (not validated)':
        print('[STOP] License is missing or placeholder. Edit the existing INI with a valid key first.')
        suggestion('Open license config for manual editing (avoid displaying keys in chat)', f'vim {ini}')
    else:
        print('[OK] License directive populated; verify it matches the intended New Relic account.')
    if not data['enabled']:
        suggestion('Enable New Relic extension ONLY after checking scope and license',
            f'phpenmod -v {v} -s fpm newrelic')
    else:
        print('[OK] Extension is already enabled; do not enable again.')
    suggestion('Post-check: confirm module, validate PHP-FPM, and restart ONLY if approved',
        f"phpquery -v {v} -s fpm -m newrelic\n"
        f"ls -l /etc/php/{v}/fpm/conf.d/*newrelic*\n"
        f"php-fpm{v} -t\n"
        f"# Only if you enabled/changed config and have approval:\n"
        f"systemctl restart php{v}-fpm\n"
        f"systemctl is-active php{v}-fpm\n"
        f"pgrep -af '[n]ewrelic-daemon'\n"
        f"tail -n 20 /var/log/newrelic/newrelic-daemon.log\n"
        f"tail -n 20 /var/log/newrelic/php_agent.log")
print('\nCheck the actual APM dashboard for connected app and transaction data.')
print('No New Relic configuration changes were executed by this advisor.')
